rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved"
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isApprovedUser(userId) {
      // Access is self-service: every authenticated account can use its own private app data.
      return signedIn() && request.auth.uid == userId;
    }

    // Admin identity is intentionally separate from each teacher's private data.
    // Bootstrap: create admins/<YOUR_ADMIN_UID> with { active: true } in Firebase
    // Console once. Do not let clients create or edit admin records.
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // One profile document per authenticated account.
    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.status == "approved"
        && request.resource.data.uid == userId;

      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.status == resource.data.status
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isAdmin();

      // All private teacher data lives below this user's UID.
      match /appData/{docId} {
        // Read-only one-time migration path for legacy accounts created before
        // access profiles existed. Pending accounts cannot write legacy data.
        allow get: if signedIn() && request.auth.uid == userId
          && !exists(/databases/$(database)/documents/users/$(userId));
        allow read, write: if isAdmin() || isApprovedUser(userId);
      }

      match /{subcollection=**} {
        allow read, write: if isAdmin() || isApprovedUser(userId);
      }
    }

    // New account requests are visible to the requester and the admin only.
    match /accessRequests/{requestId} {
      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";

      allow get: if signedIn()
        && (request.auth.uid == requestId || isAdmin());

      allow list: if isAdmin();

      allow update, delete: if isAdmin();
    }

    // Immutable teacher-owned reading-remedial results.
    // Only the authenticated teacher dashboard can create results for its own UID.
    match /remediationResults/{resultId} {
      allow create: if signedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.studentId is int
        && request.resource.data.setId in ['R2-S01', 'R2-S02']
        && request.resource.data.attempt is int
        && request.resource.data.attempt >= 1
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 5
        && request.resource.data.total == 5
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 5
        && request.resource.data.wrongQuestionNumbers is list
        && request.resource.data.createdAt is string;
      allow get, list: if signedIn()
        && resource.data.teacherUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Explicitly deny everything else. This prevents accidental public access
    // if a new collection is added later without a matching rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
